# Copy to .env and adjust. `npm run db:start` (repo root) serves this database without Docker.
DATABASE_URL="postgresql://convo:convo@localhost:5434/convo"

# Used by `npm test`. Tests wipe this database, never point it at real data.
TEST_DATABASE_URL="postgresql://convo:convo@localhost:5434/convo_test"

# Optional. With Redis, several API instances share realtime events, presence and rate limits.
# Without it everything lives in memory, which is fine for a single instance.
# REDIS_URL="redis://localhost:6379"

PORT=4200
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-change-me-change-me-change-me-0001"
JWT_REFRESH_SECRET="change-me-change-me-change-me-change-me-0002"

# Origin of the web app. WebSocket connections from any other origin are refused.
WEB_ORIGIN="http://localhost:3200"

# Set to true when served over HTTPS so auth cookies get the Secure flag.
COOKIE_SECURE=false

# Where uploaded files are stored (relative to apps/api). Several API instances must share it.
UPLOAD_DIR="uploads"
